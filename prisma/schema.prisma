// Schema dữ liệu của Toura.
// Quy ước: tên model/field trong code dùng camelCase, trong database dùng snake_case (qua @map / @@map).
// Tiền lưu bằng Int (VND, không có số lẻ) — không bao giờ dùng Float cho tiền.
// Các ràng buộc CHECK và partial unique index Prisma không hỗ trợ → nằm trong file migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  STAFF
  ADMIN
}

enum SessionStatus {
  DRAFT // chưa mở bán
  OPEN // đang mở bán
  CLOSED // tạm ngừng bán
  CANCELLED // đã hủy (vd: mưa bão)
}

enum BookingStatus {
  PENDING // đang giữ chỗ, chờ thanh toán
  CONFIRMED // đã thanh toán, đã xác nhận
  CANCELLED // bị hủy (khách/admin)
  EXPIRED // quá hạn giữ chỗ mà chưa thanh toán
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
}

// Ai đã gây ra một thay đổi
enum ActorType {
  CUSTOMER
  STAFF
  ADMIN
  SYSTEM
}

// ─────────────────────────────────────────────
// Nhân viên / quản trị
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash") // KHÔNG BAO GIỜ lưu mật khẩu thô
  name         String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  checkedInTickets Ticket[]
  auditLogs        AuditLog[]
  statusChanges    BookingStatusHistory[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Danh mục: Experience 1 ──< Session
// ─────────────────────────────────────────────

model Experience {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique // dùng trên URL: /experiences/tour-am-thuc-pho-co
  title           String
  description     String
  meetingPoint    String   @map("meeting_point")
  durationMinutes Int      @map("duration_minutes")
  defaultPrice    Int      @map("default_price") // giá gợi ý khi tạo session mới
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sessions Session[]

  @@map("experiences")
}

model Session {
  id           String        @id @default(uuid()) @db.Uuid
  experienceId String        @map("experience_id") @db.Uuid
  startsAt     DateTime      @map("starts_at") @db.Timestamptz
  capacity     Int
  seatsBooked  Int           @default(0) @map("seats_booked") // CHECK 0 <= seats_booked <= capacity
  price        Int // giá/người của riêng buổi này
  status       SessionStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  bookings   Booking[]

  @@index([experienceId, startsAt])
  @@index([status, startsAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// Đặt chỗ: Booking 1 ──< Payment / Ticket / History
// ─────────────────────────────────────────────

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique // mã ngắn cho khách: TRA-7X3K9
  idempotencyKey  String?       @unique @map("idempotency_key") @db.Uuid // chống tạo đơn trùng khi gửi lặp
  sessionId       String        @map("session_id") @db.Uuid
  contactName     String        @map("contact_name")
  contactEmail    String        @map("contact_email")
  contactPhone    String        @map("contact_phone")
  quantity        Int // CHECK > 0
  unitPrice       Int           @map("unit_price") // snapshot giá lúc đặt
  totalAmount     Int           @map("total_amount") // CHECK = unit_price * quantity
  status          BookingStatus @default(PENDING)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz // hạn giữ chỗ
  cancelledBy     ActorType?    @map("cancelled_by")
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledReason String?       @map("cancelled_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  session       Session                @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  payments      Payment[]
  tickets       Ticket[]
  statusHistory BookingStatusHistory[]

  @@index([sessionId, status])
  @@index([status, expiresAt]) // job dọn đơn hết hạn: WHERE status='PENDING' AND expires_at < now()
  @@index([contactEmail])
  @@map("bookings")
}

// Chỉ thêm, không sửa, không xóa (append-only)
model BookingStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status") // null = lúc mới tạo đơn
  toStatus    BookingStatus  @map("to_status")
  actorType   ActorType      @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid // nhân viên/admin nào (nếu có)
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  bookingId        String        @map("booking_id") @db.Uuid
  provider         String // vnpay | momo | stripe ...
  providerTxnId    String?       @unique @map("provider_txn_id") // mã giao dịch của cổng → chống xử lý trùng
  amount           Int
  status           PaymentStatus @default(PENDING)
  failureReason    String?       @map("failure_reason")
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz
  refundAmount     Int?          @map("refund_amount")
  refundReason     String?       @map("refund_reason")
  providerRefundId String?       @unique @map("provider_refund_id")
  refundedAt       DateTime?     @map("refunded_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("payments")
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  bookingId    String       @map("booking_id") @db.Uuid
  code         String       @unique // chuỗi ngẫu nhiên an toàn, in thành QR
  attendeeName String?      @map("attendee_name")
  status       TicketStatus @default(VALID)
  checkedInAt  DateTime?    @map("checked_in_at") @db.Timestamptz
  checkedInBy  String?      @map("checked_in_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  checkedInUser User?   @relation(fields: [checkedInBy], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("tickets")
}

// ─────────────────────────────────────────────
// Hạ tầng: webhook & audit
// ─────────────────────────────────────────────

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  payload         Json // nguyên văn nội dung nhận được
  signatureValid  Boolean   @map("signature_valid")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, providerEventId]) // cùng 1 sự kiện gửi lại → bị chặn
  @@map("webhook_events")
}

// Nhật ký mọi hành động quan trọng: ai, làm gì, trên đối tượng nào, lúc nào
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String // vd: "session.cancel", "payment.refund"
  entityType  String    @map("entity_type") // vd: "Session", "Booking"
  entityId    String    @map("entity_id")
  metadata    Json? // dữ liệu kèm theo: giá trị cũ/mới, lý do...
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
