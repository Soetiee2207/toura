# Copy file này thành .env rồi điền giá trị thật
POSTGRES_USER=toura
POSTGRES_PASSWORD=change_me
POSTGRES_DB=toura

DATABASE_URL="postgresql://toura:change_me@localhost:5432/toura?schema=public"

# Thời gian giữ chỗ của đơn PENDING (phút). Mốc 1: 1440 = 24h (xác nhận thủ công). Mốc 2: 15.
BOOKING_HOLD_MINUTES=1440
DATABASE_URL_TEST="postgresql://toura:change_me@localhost:5432/toura_test?schema=public"
